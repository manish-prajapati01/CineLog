PORT=5001
MONGO_URL=mongodb://127.0.0.1:27017/movie-review
JWT_SECRET=replace-with-a-long-random-secret
TMDB_API_KEY=your-tmdb-key
CLIENT_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
NODE_ENV=development
# Optional
# OMDB_API_KEY=
# cloudinary_cloud_name=
# cloudinary_api_key=
# cloudinary_api_secret=
# ADMIN_EMAIL=
# ADMIN_PASSWORD=

# Number of trusted reverse-proxy hops. Render defaults to 1; local defaults to 0.
# TRUST_PROXY_HOPS=1

# Production public URL (email links, sitemap)
PUBLIC_SITE_URL=https://cinelog-two.vercel.app
# Optional independent database name (defaults to movie-review)
# MONGO_DB_NAME=movie-review
# Password reset and email verification: verified sending domain required
# RESEND_API_KEY=
# MAIL_FROM=CineLog <accounts@your-domain.example>
# Exact-identity TVmaze fallback is on by default; attribution is displayed.
# TVMAZE_ENABLED=false
# Film fallback: OMDB_API_KEY above; check commercial-use terms before monetizing.
# Automatic provider audio/subtitle tracks (Movie of the Night v4)
# STREAMING_AVAILABILITY_API_KEY=
# STREAMING_AVAILABILITY_PLATFORM=direct
# Use rapidapi instead of direct for RapidAPI-issued keys.
# Mongo-backed rate limits are the production default. Memory is for local development only.
# RATE_LIMIT_STORE=memory
# Encrypted backup key: 32 random bytes as 64 hex characters; keep separately from backup files.
# BACKUP_ENCRYPTION_KEY=
